node_modules/
.DS_Store
Thumbs.db

# Claude Code local tooling config (launch.json, local settings)
.claude/

# Raw deep-research exports (multi-MB binaries). The verified findings live in
# docs/research/*.md — the raw files are inputs, and several of their numbers
# turned out to be fabricated, so they are not a citable record.
docs/research/*.docx

# Publisher PDFs of cited papers. Read to verify findings, never redistributed --
# this repo is public and the articles are copyrighted. The verified numbers live
# in docs/research/*.md; the DOIs there are the citable record.
docs/article/

# npm writes this when Playwright is installed for the browser tests. CI
# installs Playwright with --no-save (see .github/workflows/ci.yml) precisely so
# the project stays dependency-free; a committed lockfile pins a version the
# workflow does not use and drifts from package.json on every release.
package-lock.json
